# Browser-visible Supabase configuration. These are publishable values and are protected by Auth + RLS.
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Never commit real secrets.
# SUPABASE_SERVICE_ROLE_KEY is server-side only and is used by the deployed
# Supabase Edge Function environment, not by this Vite application.
# Do not prefix private secrets with VITE_.
